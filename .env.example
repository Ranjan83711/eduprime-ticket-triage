# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
GROQ_API_KEY=

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=eduprime-ticket-triage

# Email channel (optional): a dedicated Gmail inbox + a Gmail App Password
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Where "human needed" alerts are emailed
SENIOR_SUPPORT_EMAIL=

# Gmail API sending (needed on Render free tier, which blocks SMTP). Client from Google Cloud;
# GMAIL_REFRESH_TOKEN is filled in by: cd backend && python -m scripts.gmail_auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# WhatsApp via Twilio (sandbox): from the Twilio Console home page
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp via Meta Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_APP_SECRET=
# any random string; enter the same value as the webhook "Verify token" in Meta
META_WA_VERIFY_TOKEN=
